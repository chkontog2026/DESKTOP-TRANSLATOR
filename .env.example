# Set to true to send an email when each media file finishes.
ENABLE_EMAIL_NOTIFICATION=false

# SMTP email settings.
SMTP_TO=your@email.com
SMTP_FROM=your@email.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@email.com
SMTP_PASSWORD=your_app_password
SMTP_USE_SSL=true

# Optional API keys used by the translation providers.
# OPENAI_API_KEY=
# VNAIPRO_API_KEY=
# VNAIPRO_GEMINI_API_KEY=
# VNAIPRO_GEMINI_API_KEY is shared by VNAI Gemini transcription and translation.
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# AIPRIMETECH_API_KEY=

# Required when ElevenLabs Scribe v2 or ElevenLabs Dubbing is selected.
# For Dubbing, set the API key's Dubbing permission to Write (includes Read).
# ELEVENLABS_API_KEY=
